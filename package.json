{
  "name": "@natlibfi/mongo-cleaner",
  "version": "4.0.1",
  "license": "MIT",
  "description": "Mongo database cleaner. Removes all items from collection based on creationTime time stamp (UTC)",
  "author": {
    "name": "The National Library of Finland"
  },
  "homepage": "https://github.com/natlibfi/mongo-cleaner",
  "bugs": {
    "url": "https://github.com/natlibfi/mongo-cleaner/issues"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "bin": "./dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "rm -rf dist && tsc",
    "prepare": "npm run build",
    "lint": "eslint src",
    "lint:dev": "eslint --fix src",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:base": "node --test --test-force-exit --experimental-test-coverage --test-reporter=spec './src/*.test.ts'",
    "test:base:only": "node --test-only --test-force-exit --experimental-test-coverage --test-reporter=spec './src/*.test.ts'",
    "test": "npm run lint && npm run typecheck && npm run test:base",
    "test:dev": "npm run lint:dev && npm run test:base"
  },
  "dependencies": {
    "@natlibfi/melinda-commons": "^16.0.0",
    "moment": "^2.31.0",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@natlibfi/fixugen": "^4.0.0",
    "@natlibfi/fixura": "^5.0.0",
    "@natlibfi/fixura-mongo": "^4.0.2",
    "@types/node": "^26.6.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
